{
  "manifest_version": 2,
  "name": "Flow Twitch Session",
  "version": "1.3",
  "browser_specific_settings": {
    "gecko": { "id": "twitch-login@flow.namecallfilter.com" }
  },
  "permissions": ["cookies", "webRequest", "nativeMessaging", "geckoViewAddons", "https://*.twitch.tv/*"],
  "background": { "scripts": ["background.js"] }
}
